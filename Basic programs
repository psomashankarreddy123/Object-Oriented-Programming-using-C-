//[1]sum and average of three numbers
#include<iostream>
using namespace std;
int main()
{
    int a,b,c,sum,avg;
    cout << "Enter the three numbers : ";
    cin >>a>>b>>c;
    sum=a+b+c;
    avg=(sum)/3;
    cout<<"The sum of the numbers is : "<<sum;
    cout<<"\nThe average of the numbers is : "<<avg;
}


